 let elementsPanelInstance;
+let hippyInspectorRequestSequence = 0;
+async function inspectHippyNode(node) {
+  const requestSequence = ++hippyInspectorRequestSequence;
+  const runtimeModel = node.domModel().runtimeModel();
+  const executionContext = runtimeModel && (runtimeModel.defaultExecutionContext() || runtimeModel.executionContexts()[0]);
+  if (!executionContext) {
+    return;
+  }
+  try {
+    const expression = "(function(){var root=typeof global!=='undefined'?global:this;var devtools=root&&root.__HIPPY_DEVTOOLS__;return devtools&&typeof devtools.inspectNode==='function'?devtools.inspectNode(" + JSON.stringify(node.id) + "):null;}())";
+    const evaluation = await executionContext.evaluate({ expression, silent: true, returnByValue: true }, false, true);
+    if (requestSequence !== hippyInspectorRequestSequence) {
+      return;
+    }
+    const inspectorData = evaluation && evaluation.object && evaluation.object.value;
+    if (inspectorData) {
+      console.log("[Hippy Inspector] selected node:", inspectorData);
+    }
+  } catch (error) {
+    if (requestSequence === hippyInspectorRequestSequence) {
+      console.warn("[Hippy Inspector] failed to inspect selected node:", error);
+    }
+  }
+}
